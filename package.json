{
  "name": "dsh-plugin-redmine",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "description": "Read-only Redmine dispatcher with native DSH workspaces and sessions",
  "main": "./dist/host/index.js",
  "exports": {
    ".": "./dist/host/index.js",
    "./client": "./dist/client/index.js",
    "./typert": "./dist/host/typert.js",
    "./remote": "./dist/client/remote.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "books/COMPATIBILITY.md",
    "books/REDMINE_ENDPOINTS.md"
  ],
  "scripts": {
    "typecheck": "node scripts/typecheck.mjs",
    "build": "node scripts/typecheck.mjs && tsc && node scripts/build.mjs",
    "test": "npm run build && node --test test/*.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-typert-registry"
      ]
    }
  },
  "engines": {
    "dsh": "0.2.1-rc.5",
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.5",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.5"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "overrides": {
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.5",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.5",
    "@playwright/mcp": "0.0.83",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3"
  }
}
